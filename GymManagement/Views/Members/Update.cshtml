@model UpdateMemberViewModel
@{
    ViewData["Title"] = "Member Update";
}
<div class="container">
    <main role="main" class="pb-3">
        

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-details border-0 p-2 shadow">
                        <div class="card-body text-center">
                           
                            <div class="card-body text-center">
                                <form asp-controller="Members" asp-action="Update" method="post" enctype="multipart/form-data">
                                    <div class="text-center mt-3">
                                        @{
                                            var photoSrc = string.IsNullOrWhiteSpace(Model.Photo)
                                                ? Url.Content("~/images/person.png")
                                                : Url.Action("Picture", "Members", new { id = Model.Id });
                                        }

                                        <label for="photoInput" style="cursor:pointer; position:relative; display:inline-block;" title="Click to change photo">
                                            <img id="photoPreview" src="@photoSrc" alt="Member photo" class="rounded-circle"
                                                 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />

                                            <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                  style="width: 32px; height: 32px;">
                                                <i class="bi bi-camera-fill"></i>
                                            </span>
                                        </label>

                                        <input type="hidden" asp-for="Photo" />
                                        <input asp-for="PhotoFile" type="file" id="photoInput" accept="image/*" class="d-none" />
                                        <div><span asp-validation-for="PhotoFile" class="text-danger"></span></div>
                                    </div>
                                    <h2 class="mb-1 text-primary-color">@Model.Name</h2>

                                    <div class="mt-4 text-start">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Name</small>
                                                    <input asp-for="Name" class="form-control" />
                                                    <span asp-validation-for="Name" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Email</small>
                                                    <input asp-for="Email" class="form-control" />
                                                    <span asp-validation-for="Email" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Phone</small>
                                                    <input asp-for="Phone" class="form-control" />
                                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Building Number</small>
                                                    <input asp-for="BuildingNumber" class="form-control" />
                                                    <span asp-validation-for="BuildingNumber"
                                                          class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">City</small>
                                                    <input asp-for="City" class="form-control" />
                                                    <span asp-validation-for="City" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 bg-light rounded">
                                                    <small class="text-muted d-block mb-1">Street</small>
                                                    <input asp-for="Street" class="form-control" />
                                                    <span asp-validation-for="Street" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="d-flex justify-content-between gap-2 mt-3 px-3 pb-3">
                                        <a asp-controller="Members" asp-action="Index" class="btn btn-fill ">
                                            Back to
                                            List
                                        </a>
                                        <button type="submit" class="btn btn-fill ">Done</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>



    </main>
</div>
@section NoRender
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('photoInput').addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                document.getElementById('photoPreview').src = URL.createObjectURL(file);
            }
        });
    </script>
}

